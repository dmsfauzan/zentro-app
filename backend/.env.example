APP_NAME=ZENTRO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Observability (Phase 8.5) ---
OBSERVABILITY_SLOW_REQUEST_MS=1000
OBSERVABILITY_LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zentro
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=zentro

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@zentro.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Firebase (identity provider) ---
# Relatif terhadap base_path() (folder backend/), mis. storage/app/firebase/service-account.json.
# JANGAN commit kredensial asli.
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
FIREBASE_FAKE_VERIFIER=true
# Toleransi selisih jam (detik) saat memvalidasi klaim waktu ID token.
FIREBASE_TOKEN_LEEWAY=60

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# --- Payment gateway ---
# fake   = tanpa kredensial (default lingkungan lokal & test)
# midtrans = aktif setelah kredensial sandbox diisi
PAYMENT_GATEWAY=fake
PAYMENT_FAKE_SECRET=change-me-in-local
PAYMENT_WEBHOOK_IPS=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Signature Secret Key (terpisah dari server key) untuk verifikasi signature
# notifikasi. Kosongkan hanya bila akun memakai server key sebagai signature key.
MIDTRANS_SIGNATURE_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com
MIDTRANS_API_URL=https://api.sandbox.midtrans.com
MIDTRANS_PAYMENTS=qris,gopay,bca_va,bni_va,bri_va,cimb_va,permata_va,mandiri_va

# --- Shipping ---
# manual = seller input resi sendiri (tanpa agregator)
# fake   = test/simulator
SHIPPING_DRIVER=manual
SHIPPING_WEBHOOK_SECRET=change-me-in-local
SHIPPING_FLAT_RATE=15000
SHIPPING_FREE_THRESHOLD=

# --- Finance ---
COMMISSION_DEFAULT_RATE_BP=500
PAYOUT_MIN_AMOUNT=10000
PAYOUT_DUAL_CONTROL_THRESHOLD=0
SETTLEMENT_HOLD_DAYS=7

# --- Asisten belanja (chatbot) ---
# Endpoint OpenAI-compatible (9router: http://localhost:20128/v1). Isi
# ASSISTANT_API_KEY bila router mewajibkan bearer token. Jangan commit kunci asli.
ASSISTANT_ENABLED=true
ASSISTANT_BASE_URL=http://localhost:20128/v1
ASSISTANT_API_KEY=
ASSISTANT_MODEL=assist
ASSISTANT_TIMEOUT_SECONDS=25
ASSISTANT_MAX_PRODUCTS=6

# --- S3-compatible storage ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
