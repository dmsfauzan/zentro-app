# Salin ke `.env` di root lalu sesuaikan. Dipakai oleh docker-compose.staging.yml.
# JANGAN commit file `.env` yang sudah berisi rahasia.

APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_KEY=
HTTP_PORT=8080

DB_DATABASE=zentro
DB_USERNAME=zentro
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost/api/v1
CORS_ALLOWED_ORIGINS=http://localhost

# Tanpa kredensial produksi: tetap fake/manual.
FIREBASE_FAKE_VERIFIER=true
PAYMENT_GATEWAY=fake
SHIPPING_DRIVER=manual
